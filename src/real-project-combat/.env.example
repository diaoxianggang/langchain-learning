# ===== 个人知识库项目（real-project-combat）环境变量样例 =====
# 复制为项目根目录 .env（或直接追加到根 .env）并按需修改。

# 知识库服务
KB_SERVER_PORT=3001
# 知识库资料来源目录（可配置，默认指向本仓库 docs 目录）
KB_SOURCE_DIR=f:\project\langchain-learning\docs
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80

# Ollama（本地向量化模型）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Qdrant（Docker 向量数据库）
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_docs

# PostgreSQL（Docker 数据库，文档注册表 + 对话记忆）
PG_CONNECTION_STRING=postgres://admin:Admin@123@localhost:5432/my_db

# 以下为 MIMO 在线模型配置（复用根 .env 已有配置）
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=...
# MIMO_MODEL=mimo-v2.5-pro
